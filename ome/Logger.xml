<?xml version="1.0" encoding="UTF-8"?>

<Logger version="2">
	<!-- Logs go to stdout/stderr, which is what Docker captures. -->
	<File enabled="false" />

	<Tag name="SRT" level="critical" />
	<Tag name="HTTP.Server" level="warn" />
	<Tag name=".*\.Stat" level="warn" />

	<!-- Log level: [debug, info, warn, error, critical] -->
	<Tag name=".*" level="info" />
</Logger>
