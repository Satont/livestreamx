API_PORT=1337
API_SESSION_SECRET=secret

TWITCH_CLIENT_ID=
TWITCH_SECRET=
TWITCH_REDIRECT_URI=http://localhost:1337/auth/twitch/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:1337/auth/github/callback

THUMBNAILS_URI=http://localhost:1337/streams/thumbnails

# OvenMediaEngine
# ports are mapped in docker-compose.dev.yml
OME_API_ADDR=http://localhost:9998
OME_API_ACCESS_TOKEN=livestreamx
OME_VHOST=default
OME_APP=app
OME_LLHLS_ADDR=http://localhost:3334
# must match OME_ADMISSION_SECRET of the ome service
OME_ADMISSION_SECRET=livestreamx

NATS_URL=nats://localhost:8223

POSTGRES_URL=postgres://stream:stream@localhost:8832/stream
REDIS_URL=redis://localhost:8879

# S3 (optional, integration is currently disabled)
S3_HOST=localhost:8810
S3_ACCESS_TOKEN=minio
S3_SECRET_TOKEN=minio-password
S3_REGION=auto
S3_BUCKET=livestreamx

# production only: domain used in traefik labels (docker-compose.yml)
#DOMAIN=streamx.satont.dev
